# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored. Never commit real credentials.
#
# Everything here is SERVER-SIDE ONLY. Do not prefix any of these with VITE_,
# and do not import them into src/ — anything VITE_-prefixed is bundled into
# client JavaScript and would be public.

# --- TypeSafe Jev API -------------------------------------------------------
# Required. Used only by the /api/ask server function.
TYPESAFE_API_KEY=your-typesafe-api-key

# Optional. Test-only override that points the server at a mock upstream.
# Leave unset in production.
# TYPESAFE_BASE_URL=http://127.0.0.1:4180

# --- Upstash Redis (rate limiting) ------------------------------------------
# Optional locally: with these unset, /api/ask runs unlimited so local
# development and tests stay usable. Required in production — without them the
# 10-requests-per-minute-per-IP limit is inactive.
#
# Create a Redis database at https://console.upstash.com, then copy the REST
# URL and REST token from the database's "REST API" section.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# --- Private benchmark bypass -----------------------------------------------
# Optional. When set, a request carrying a matching 'x-benchmark-token' header
# skips the public rate limit (10 requests / 60 s / IP). Used by
# scripts/benchmark.ps1 to run the 100-question prompt regression suite.
#
# Leave this UNSET in normal operation: without it the bypass is disabled and
# every request is rate limited like a public one. Generate a long random value,
# store it only here and in Vercel, and never commit the real token.
BENCHMARK_BYPASS_TOKEN=your-private-benchmark-token
